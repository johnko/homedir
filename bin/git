#!/usr/bin/env bash
set -eo pipefail

# https://developer.apple.com/documentation/xcode/installing-the-command-line-tools/
GIT_BIN="/Library/Developer/CommandLineTools/usr/bin/git"

exit_error() {
  echo "ERROR: detected running in cursor. Aborting."
  exit 1
}

DETECTED=""
if [[ ! -e "$HOME/.allowed_git_remote" ]]; then
  if [[ -n $CODEX_SHELL && $CODEX_SHELL == "1" ]]; then
    DETECTED=codex
    export SSH_AUTH_SOCK=""
    export GPG_SIGN=""
    exit_error
  fi
  if set | grep -v grep | grep VSCODE | grep -q -E '/(Cursor|cursor)/'; then
    DETECTED=cursor
    export SSH_AUTH_SOCK=""
    export GPG_SIGN=""
    exit_error
  fi
  if set | grep -v grep | grep VSCODE | grep -q -E '/(Visual Studio Code.app)/'; then
    DETECTED=code
    ## if in VSCode, unset SSH_AUTH_SOCK to avoid endless 1Password prompt for ssh-agent
    ## dev container seems to still set it, so we control from ssh wrapper
    if echo "$@" | grep -q -E '(devcontainer-dotfiles)'; then
      # allow for devcontainer-dotfiles
      sleep 0
    else
      export SSH_AUTH_SOCK=""
      export GPG_SIGN=""
      exit_error
    fi
  fi
fi

# if not in Codex/Cursor (eg Terminal), set ssh-agent
export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"

# dynamically add gpg-sign if allowed (Terminal) or not cursor
if [[ -e "$HOME/.allowed_git_sign" ]] || [[ $DETECTED != "cursor" && $DETECTED != "codex" ]]; then
  if echo "$@" | sed -e 's,committer,,ig' -e 's,reverts,,ig' | grep -q -E " (amend|cherry-pick|commit|merge|rebase|revert|$($GIT_BIN config --get-regexp '^alias\.' | grep -E 'amend|cherry-pick|commit|rebase|merge|revert' | sed -e 's/^alias\.//g' -e 's/ .*//g' | tr '\n' '|' | sed 's,|$,,'))"; then
    export GPG_SIGN="--gpg-sign"
  fi
fi

# absolute path so we don't get into endless loop
$GIT_BIN "$@" $GPG_SIGN
